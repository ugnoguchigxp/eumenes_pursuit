{
	"name": "eumenes-pursuit",
	"version": "0.0.2",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./sqlite": "./src/sqlite.ts"
	},
	"scripts": {
		"verify": "bun scripts/verify.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"check:python": "bun scripts/check-python.ts",
		"check:boundaries": "bun scripts/check-boundaries.ts",
		"check:results": "bun scripts/check-results.ts",
		"test": "bun test ./src ./test ./standalone ./eval",
		"pack:core": "bun scripts/pack-core.ts",
		"build": "tsc -p tsconfig.build.json",
		"pursuit": "bun standalone/cli.ts",
		"eval": "bun eval/main.ts",
		"label": "bun eval/label/main.ts"
	},
	"dependencies": {
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "0.131.0",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"katex": "0.18.2",
		"openai": "7.51.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3"
	},
	"packageManager": "bun@1.4.4"
}
